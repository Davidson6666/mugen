# Copie este arquivo para .env.local e preencha com os dados do SEU projeto no
# Supabase (painel > Project Settings > API). O .env.local nunca vai para o git.
#
# Use SO a chave "anon" (publishable): ela pode ir para o navegador porque as
# tabelas tem RLS. NUNCA coloque aqui a chave "service_role" (administrativa).

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
